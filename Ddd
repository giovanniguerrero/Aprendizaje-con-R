def generate_gbm_code(model, feature_names):
    """
    Genera código Python independiente para un modelo GBM.
    
    Parámetros:
    - model: Modelo GBM entrenado.
    - feature_names: Nombres de las características.
    
    Retorna:
    - Código Python como una cadena.
    """
    # Valor inicial
    init = model.init_.predict([[0]])[0]
    learning_rate = model.learning_rate

    # Generar código para cada árbol
    trees_code = ""
